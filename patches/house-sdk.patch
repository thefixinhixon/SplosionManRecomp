+bool D3D12Presenter::GetGuestOutputSharedTexture(GuestOutputSharedTexture& out) {
+  Microsoft::WRL::ComPtr<ID3D12Resource> guest_output_resource;
+  uint32_t mailbox_index = UINT32_MAX;
+  UINT64 submission_index = 0;
+  {
+    uint32_t idx;
+    std::unique_lock<std::mutex> lock(ConsumeGuestOutput(idx, nullptr, nullptr));
+    if (idx == UINT32_MAX) {
+      REXLOG_WARN("D3D12Presenter: GetGuestOutputSharedTexture - no guest output available");
+      return false;
+    }
+    mailbox_index = idx;
+    guest_output_resource = guest_output_resources_[idx].second;
+    submission_index = guest_output_resources_[idx].first;
+  }
+  if (!guest_output_resource) {
+    REXLOG_WARN("D3D12Presenter: GetGuestOutputSharedTexture - null resource at index {}", mailbox_index);
+    return false;
+  }
+
+  guest_output_resource_refresher_submission_tracker_.AwaitSubmissionCompletion(
+      submission_index);
+
+  D3D12_RESOURCE_DESC src_desc = guest_output_resource->GetDesc();
+  uint32_t width = uint32_t(src_desc.Width);
+  uint32_t height = src_desc.Height;
+
+  auto& shared_copy = guest_output_shared_copy_resources_[mailbox_index];
+  bool need_recreate = false;
+  if (shared_copy) {
+    D3D12_RESOURCE_DESC copy_desc = shared_copy->GetDesc();
+    if (copy_desc.Width != src_desc.Width || copy_desc.Height != src_desc.Height) {
+      shared_copy.Reset();
+      if (guest_output_shared_handles_[mailbox_index]) {
+        CloseHandle(guest_output_shared_handles_[mailbox_index]);
+        guest_output_shared_handles_[mailbox_index] = nullptr;
+      }
+      need_recreate = true;
+    }
+  } else {
+    need_recreate = true;
+  }
+
+  if (need_recreate) {
+    ID3D12Device* device = provider_.GetDevice();
+    D3D12_RESOURCE_DESC copy_desc;
+    copy_desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    copy_desc.Alignment = 0;
+    copy_desc.Width = width;
+    copy_desc.Height = height;
+    copy_desc.DepthOrArraySize = 1;
+    copy_desc.MipLevels = 1;
+    copy_desc.Format = kGuestOutputFormat;
+    copy_desc.SampleDesc.Count = 1;
+    copy_desc.SampleDesc.Quality = 0;
+    copy_desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    copy_desc.Flags = D3D12_RESOURCE_FLAG_NONE;
+    HRESULT hr = device->CreateCommittedResource(
+        &util::kHeapPropertiesDefault,
+        D3D12_HEAP_FLAG_SHARED,
+        &copy_desc, D3D12_RESOURCE_STATE_COMMON, nullptr,
+        IID_PPV_ARGS(&shared_copy));
+    if (FAILED(hr)) {
+      REXLOG_ERROR("D3D12Presenter: Failed to create shared copy {}x{} (hr=0x{:08X})",
+                   width, height, uint32_t(hr));
+      return false;
+    }
+  }
+
+  if (!guest_output_copy_cmd_allocator_) {
+    ID3D12Device* device = provider_.GetDevice();
+    HRESULT hr = device->CreateCommandAllocator(
+        D3D12_COMMAND_LIST_TYPE_DIRECT,
+        IID_PPV_ARGS(&guest_output_copy_cmd_allocator_));
+    if (FAILED(hr)) {
+      REXLOG_ERROR("D3D12Presenter: Failed to create copy cmd allocator (hr=0x{:08X})",
+                   uint32_t(hr));
+      return false;
+    }
+    hr = device->CreateCommandList(
+        0, D3D12_COMMAND_LIST_TYPE_DIRECT,
+        guest_output_copy_cmd_allocator_.Get(), nullptr,
+        IID_PPV_ARGS(&guest_output_copy_cmd_list_));
+    if (FAILED(hr)) {
+      REXLOG_ERROR("D3D12Presenter: Failed to create copy cmd list (hr=0x{:08X})",
+                   uint32_t(hr));
+      return false;
+    }
+    hr = device->CreateFence(
+        0, D3D12_FENCE_FLAG_SHARED,
+        IID_PPV_ARGS(&guest_output_copy_fence_));
+    if (FAILED(hr)) {
+      REXLOG_ERROR("D3D12Presenter: Failed to create copy fence (hr=0x{:08X})",
+                   uint32_t(hr));
+      return false;
+    }
+  }
+
+  guest_output_copy_cmd_allocator_->Reset();
+  guest_output_copy_cmd_list_->Reset(
+      guest_output_copy_cmd_allocator_.Get(), nullptr);
+
+  D3D12_RESOURCE_BARRIER barriers[2];
+  UINT barrier_count = 0;
+
+  barriers[barrier_count].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+  barriers[barrier_count].Flags = D3D12_RESOURCE_BARRIER_FLAG_NONE;
+  barriers[barrier_count].Transition.pResource = guest_output_resource.Get();
+  barriers[barrier_count].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+  barriers[barrier_count].Transition.StateBefore = kGuestOutputInternalState;
+  barriers[barrier_count].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+  barrier_count++;
+
+  barriers[barrier_count].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+  barriers[barrier_count].Flags = D3D12_RESOURCE_BARRIER_FLAG_NONE;
+  barriers[barrier_count].Transition.pResource = shared_copy.Get();
+  barriers[barrier_count].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+  barriers[barrier_count].Transition.StateBefore = D3D12_RESOURCE_STATE_COMMON;
+  barriers[barrier_count].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+  barrier_count++;
+
+  guest_output_copy_cmd_list_->ResourceBarrier(barrier_count, barriers);
+  guest_output_copy_cmd_list_->CopyResource(
+      shared_copy.Get(), guest_output_resource.Get());
+
+  D3D12_RESOURCE_BARRIER restore_barrier;
+  restore_barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+  restore_barrier.Flags = D3D12_RESOURCE_BARRIER_FLAG_NONE;
+  restore_barrier.Transition.pResource = guest_output_resource.Get();
+  restore_barrier.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+  restore_barrier.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+  restore_barrier.Transition.StateAfter = kGuestOutputInternalState;
+  guest_output_copy_cmd_list_->ResourceBarrier(1, &restore_barrier);
+
+  D3D12_RESOURCE_BARRIER copy_to_shared_barrier;
+  copy_to_shared_barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+  copy_to_shared_barrier.Flags = D3D12_RESOURCE_BARRIER_FLAG_NONE;
+  copy_to_shared_barrier.Transition.pResource = shared_copy.Get();
+  copy_to_shared_barrier.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+  copy_to_shared_barrier.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+  copy_to_shared_barrier.Transition.StateAfter = D3D12_RESOURCE_STATE_COMMON;
+  guest_output_copy_cmd_list_->ResourceBarrier(1, &copy_to_shared_barrier);
+
+  guest_output_copy_cmd_list_->Close();
+  ID3D12CommandList* cmd_list = guest_output_copy_cmd_list_.Get();
+  provider_.GetDirectQueue()->ExecuteCommandLists(1, &cmd_list);
+
+  guest_output_copy_fence_value_++;
+  provider_.GetDirectQueue()->Signal(
+      guest_output_copy_fence_.Get(), guest_output_copy_fence_value_);
+
+  while (guest_output_copy_fence_->GetCompletedValue() <
+         guest_output_copy_fence_value_) {
+    Sleep(0);
+  }
+
+  if (!guest_output_shared_handles_[mailbox_index]) {
+    Microsoft::WRL::ComPtr<ID3D12Device1> device1;
+    HRESULT hr = provider_.GetDevice()->QueryInterface(IID_PPV_ARGS(&device1));
+    if (FAILED(hr)) {
+      REXLOG_ERROR("D3D12Presenter: QueryInterface(ID3D12Device1) failed (hr=0x{:08X})",
+                   uint32_t(hr));
+      return false;
+    }
+    SECURITY_ATTRIBUTES sa{};
+    sa.nLength = sizeof(sa);
+    sa.lpSecurityDescriptor = nullptr;
+    sa.bInheritHandle = TRUE;
+    HANDLE handle = nullptr;
+    hr = device1->CreateSharedHandle(
+            shared_copy.Get(), &sa,
+            GENERIC_ALL, nullptr, &handle);
+    if (FAILED(hr)) {
+      REXLOG_ERROR("D3D12Presenter: ID3D12Device1::CreateSharedHandle failed (hr=0x{:08X})",
+                   uint32_t(hr));
+      return false;
+    }
+    guest_output_shared_handles_[mailbox_index] = handle;
+  }
+
+  LUID adapter_luid = provider_.GetDevice()->GetAdapterLuid();
+
+  out.handle = guest_output_shared_handles_[mailbox_index];
+  out.width = width;
+  out.height = height;
+  out.adapter_luid_low = uint32_t(adapter_luid.LowPart);
+  out.adapter_luid_high = int32_t(adapter_luid.HighPart);
+
+  guest_output_shared_texture_ref_ = guest_output_resource;
+
+  return true;
