+void CommandProcessor::TraceVertexFetchOOB(const Shader& vertex_shader,
+                                           uint32_t index_count,
+                                           const IndexBufferInfo* index_buffer_info) {
+  uint64_t max_index = index_count ? uint64_t(index_count - 1) : 0;
+  if (index_buffer_info && index_buffer_info->count) {
+    const uint32_t index_size =
+        index_buffer_info->format == xenos::IndexFormat::kInt16 ? 2 : 4;
+    const uint8_t* index_data =
+        memory_->TranslatePhysical<uint8_t*>(index_buffer_info->guest_base);
+    if (!index_data) {
+      return;
+    }
+    max_index = 0;
+    const uint32_t count = std::min<uint32_t>(
+        index_buffer_info->count, uint32_t(index_buffer_info->length / index_size));
+    const uint32_t restart = index_size == 2 ? 0xFFFFu : 0xFFFFFFFFu;
+    for (uint32_t i = 0; i < count; ++i) {
+      uint32_t index;
+      if (index_size == 2) {
+        uint16_t raw;
+        std::memcpy(&raw, index_data + i * 2, 2);
+        index = xenos::GpuSwap(raw, index_buffer_info->endianness);
+      } else {
+        uint32_t raw;
+        std::memcpy(&raw, index_data + i * 4, 4);
+        index = xenos::GpuSwap(raw, index_buffer_info->endianness);
+      }
+      if (index != restart) {
+        max_index = std::max<uint64_t>(max_index, index);
+      }
+    }
+  }
+
+  static std::unordered_set<uint64_t> reported;
+  const RegisterFile& regs = *register_file_;
+  for (const auto& binding : vertex_shader.vertex_bindings()) {
+    const xenos::xe_gpu_vertex_fetch_t vfetch =
+        regs.GetVertexFetch(binding.fetch_constant);
+    if (vfetch.type != xenos::FetchConstantType::kVertex || !vfetch.size) {
+      continue;
+    }
+
+    uint64_t max_word_end = 0;
+    int64_t min_word = 0;
+    for (const auto& attribute : binding.attributes) {
+      const auto& fetch = attribute.fetch_instr;
+      const uint32_t needed = xenos::GetVertexFormatNeededWords(
+          fetch.attributes.data_format, fetch.result.GetUsedResultComponents());
+      min_word = std::min<int64_t>(min_word, fetch.attributes.offset);
+      const int64_t end = int64_t(fetch.attributes.offset) + int64_t(needed);
+      if (end > 0) {
+        max_word_end = std::max(max_word_end, uint64_t(end));
+      }
+    }
+
+    const uint64_t last_word = max_index * binding.stride_words + max_word_end;
+    const bool oob_high = last_word > vfetch.size;
+    const bool oob_low = min_word < 0;
+    if (!oob_high && !oob_low) {
+      continue;
+    }
+
+    const uint64_t signature = (uint64_t(binding.fetch_constant) << 48) ^
+                               (uint64_t(vfetch.dword_0) << 20) ^
+                               (uint64_t(vfetch.size) << 8) ^
+                               binding.stride_words;
+    if (!reported.insert(signature).second) {
+      continue;
+    }
+    // MAW PATCH (2026-10-03): demoted to DEBUG - the dedup set is per-call, so
+    // this spams at WARN and drowns the log (5MB rotations in minutes).
+    REXGPU_DEBUG(
+        "VFETCH-OOB: indices={} fetch={} base=0x{:08X} size={}w stride={}w "
+        "max_index={} -> last word {} of {}{}",
+        index_count, binding.fetch_constant, vfetch.address << 2, vfetch.size,
+        binding.stride_words, max_index, last_word, vfetch.size,
+        oob_low ? " (also underflows below base)" : "");
+  }
+}
