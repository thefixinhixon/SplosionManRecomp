+void GraphicsSystem::OnGuestSwap() {
+  using Clock = std::chrono::steady_clock;
+  using namespace std::chrono;
+  auto& p = pacing_;
+  const uint32_t issued = ++p.guest_swaps;
+  const auto t_enter = Clock::now();
+
+  // 1. Bound how far the game runs ahead of the GPU thread. Swap #issued was
+  // just written but not yet kicked, so waiting for swap #(issued - N) lets
+  // the GPU thread work on at most N frames while the game builds the next.
+  double gpu_wait_ms = 0.0;
+  const int32_t max_ahead = REXCVAR_GET(gpu_max_frames_ahead);
+  if (max_ahead > 0 && command_processor_ && issued > uint32_t(max_ahead)) {
+    const uint32_t target = issued - uint32_t(max_ahead);
+    if (!command_processor_->WaitForSwapCount(target, milliseconds(100)) &&
+        !p.ahead_wait_timed_out_logged) {
+      p.ahead_wait_timed_out_logged = true;
+      REXGPU_WARN("gpu_max_frames_ahead: GPU thread did not reach swap {} within 100 ms "
+                  "(executed {}); continuing", target, command_processor_->swap_counter());
+    }
+    gpu_wait_ms = duration<double, std::milli>(Clock::now() - t_enter).count();
+  }
+
+  // 2. Frame limiter, deadline based so sleep error does not accumulate.
+  double limiter_ms = 0.0;
+  const int32_t limit = REXCVAR_GET(frame_limit);
+  if (limit > 0) {
+    const auto period = duration_cast<Clock::duration>(duration<double>(1.0 / limit));
+    auto now = Clock::now();
+    if (p.next_deadline == Clock::time_point{} || now - p.next_deadline > period * 2 ||
+        p.next_deadline - now > period * 2) {
+      // First frame, a hitch, or a limit change: restart the cadence.
+      p.next_deadline = now;
+    } else if (p.next_deadline > now) {
+      PreciseSleepUntil(p.next_deadline);
+      limiter_ms = duration<double, std::milli>(Clock::now() - now).count();
+    }
+    p.next_deadline += period;
+  } else {
+    p.next_deadline = {};
+  }
+
+  // 3. Overlay pause: park the guest on a finished frame.
+  bool was_held = false;
+  {
+    std::unique_lock<std::mutex> lock(frame_hold_mutex_);
+    while (frame_hold_ && vsync_worker_running_) {
+      was_held = true;
+      frame_hold_cv_.wait_for(lock, milliseconds(50));
+    }
+  }
+  if (was_held) {
+    // Restart pacing and statistics so the pause is not counted as a frame.
+    p.next_deadline = {};
+    p.last_swap = {};
+  }
+
+  // 4. Statistics.
+  const auto t_exit = Clock::now();
+  if (p.last_swap != Clock::time_point{}) {
+    const double frame_ms = duration<double, std::milli>(t_exit - p.last_swap).count();
+    p.window_frames++;
+    p.window_frame_ms_sum += frame_ms;
+    p.window_frame_ms_max = std::max(p.window_frame_ms_max, frame_ms);
+    p.window_gpu_wait_ms += gpu_wait_ms;
+    p.window_limiter_ms += limiter_ms;
+  } else {
+    p.window_start = t_exit;
+    p.last_perf_log = t_exit;
+  }
+  p.last_swap = t_exit;
+
+  const double window_s = duration<double>(t_exit - p.window_start).count();
+  if (window_s >= 0.5 && p.window_frames) {
+    system::GuestFrameStats st;
+    const double n = double(p.window_frames);
+    st.fps = n / window_s;
+    st.frame_ms = p.window_frame_ms_sum / n;
+    st.frame_max_ms = p.window_frame_ms_max;
+    st.gpu_wait_ms = p.window_gpu_wait_ms / n;
+    st.limiter_ms = p.window_limiter_ms / n;
+    st.work_ms = std::max(0.0, st.frame_ms - st.gpu_wait_ms - st.limiter_ms);
+    st.frame_count = issued;
+    {
+      std::lock_guard<std::mutex> lock(pacing_stats_mutex_);
+      pacing_stats_ = st;
+    }
+    const double log_interval = REXCVAR_GET(perf_log_interval);
+    if (log_interval > 0.0 &&
+        duration<double>(t_exit - p.last_perf_log).count() >= log_interval) {
+      p.last_perf_log = t_exit;
+      REXGPU_INFO("perf: fps={:.1f} frame={:.2f}ms max={:.2f}ms work={:.2f}ms "
+                  "gpu_wait={:.2f}ms limiter={:.2f}ms gpu_lag={} limit={} ahead={}",
+                  st.fps, st.frame_ms, st.frame_max_ms, st.work_ms, st.gpu_wait_ms,
+                  st.limiter_ms,
+                  command_processor_ ? issued - command_processor_->swap_counter() : 0, limit,
+                  max_ahead);
+    }
+    p.window_start = t_exit;
+    p.window_frames = 0;
+    p.window_frame_ms_sum = 0.0;
+    p.window_frame_ms_max = 0.0;
+    p.window_gpu_wait_ms = 0.0;
+    p.window_limiter_ms = 0.0;
+  }
+}
+
+void GraphicsSystem::SetGuestFrameHold(bool hold) {
+  {
+    std::lock_guard<std::mutex> lock(frame_hold_mutex_);
+    frame_hold_ = hold;
+  }
+  frame_hold_cv_.notify_all();
+}
+
+bool GraphicsSystem::GetGuestFrameStats(system::GuestFrameStats* out) const {
+  if (!out) {
+    return false;
+  }
+  std::lock_guard<std::mutex> lock(pacing_stats_mutex_);
+  *out = pacing_stats_;
+  return true;
+}
