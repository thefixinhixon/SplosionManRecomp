+namespace {
+
+// Runs cvar::Init on a list of arguments (argv[0] is added).
+std::vector<std::string> InitWith(std::vector<std::string> args) {
+  args.insert(args.begin(), "cvar_test");
+  std::vector<char*> argv;
+  for (auto& arg : args) {
+    argv.push_back(arg.data());
+  }
+  return rex::cvar::Init(static_cast<int>(argv.size()), argv.data());
+}
+
+}  // namespace
+
+TEST_CASE("cvar command line: a bad argument does not drop the others", "[cvar]") {
+  rex::cvar::testing::ResetAllForTesting();
+
+  SECTION("invalid value") {
+    InitWith({"--test_int32_flag=abc", "--test_string_flag=kept"});
+    CHECK(REXCVAR_GET(test_int32_flag) == 42);
+    CHECK(REXCVAR_GET(test_string_flag) == "kept");
+    CHECK(rex::cvar::TakeCommandLineWarnings().size() == 1);
+  }
+
+  SECTION("repeated flag: the last one wins") {
+    InitWith({"--test_int32_flag=1", "--test_string_flag=kept", "--test_int32_flag=2"});
+    CHECK(REXCVAR_GET(test_int32_flag) == 2);
+    CHECK(REXCVAR_GET(test_string_flag) == "kept");
+    CHECK(rex::cvar::TakeCommandLineWarnings().size() == 1);
+  }
+
+  SECTION("bad bool value") {
+    InitWith({"--test_bool_flag=maybe", "--test_string_flag=kept"});
+    CHECK(REXCVAR_GET(test_bool_flag) == false);
+    CHECK(REXCVAR_GET(test_string_flag) == "kept");
+    CHECK(rex::cvar::TakeCommandLineWarnings().size() == 1);
+  }
+
+  SECTION("missing value") {
+    InitWith({"--test_string_flag=kept", "--test_int32_flag"});
+    CHECK(REXCVAR_GET(test_int32_flag) == 42);
+    CHECK(REXCVAR_GET(test_string_flag) == "kept");
+    CHECK(rex::cvar::TakeCommandLineWarnings().size() == 1);
+  }
+
+  SECTION("warnings are taken once") {
+    InitWith({"--test_int32_flag=abc"});
+    CHECK(rex::cvar::TakeCommandLineWarnings().size() == 1);
+    CHECK(rex::cvar::TakeCommandLineWarnings().empty());
+  }
+
+  rex::cvar::testing::ResetAllForTesting();
+}
+
+TEST_CASE("cvar command line forms", "[cvar]") {
+  rex::cvar::testing::ResetAllForTesting();
+
+  SECTION("bool flags") {
+    InitWith({"--test_bool_flag"});
+    CHECK(REXCVAR_GET(test_bool_flag) == true);
+    InitWith({"--no-test_bool_flag"});
+    CHECK(REXCVAR_GET(test_bool_flag) == false);
+    InitWith({"--test_bool_flag=on"});
+    CHECK(REXCVAR_GET(test_bool_flag) == true);
+    InitWith({"--test_bool_flag=0"});
+    CHECK(REXCVAR_GET(test_bool_flag) == false);
+    CHECK(rex::cvar::TakeCommandLineWarnings().empty());
+  }
+
+  SECTION("separated value, positionals and --") {
+    auto positional = InitWith({"first", "--test_string_flag", "with space", "--test_int32_flag=7",
+                                "--", "--test_int32_flag=9"});
+    CHECK(REXCVAR_GET(test_string_flag) == "with space");
+    CHECK(REXCVAR_GET(test_int32_flag) == 7);
+    REQUIRE(positional.size() == 2);
+    CHECK(positional[0] == "first");
+    CHECK(positional[1] == "--test_int32_flag=9");
+    CHECK(rex::cvar::TakeCommandLineWarnings().empty());
+  }
+
+  SECTION("values that look like paths or contain '='") {
+    InitWith({"--test_string_flag=D:/Games/PC Games/x=y"});
+    CHECK(REXCVAR_GET(test_string_flag) == "D:/Games/PC Games/x=y");
+  }
+
+  SECTION("unregistered flags reach cvars registered later") {
+    InitWith({"--test_late_cmdline_flag=F10", "--no-test_late_bool"});
+    CHECK(rex::cvar::GetPendingCommandLineValue("test_late_cmdline_flag") == "F10");
+    CHECK(rex::cvar::GetPendingCommandLineValue("test_late_bool") == "false");
+    CHECK(rex::cvar::TakeCommandLineWarnings().empty());
+  }
+
+  rex::cvar::testing::ResetAllForTesting();
+}
+
+TEST_CASE("cvar command line: flags registered after Init are checked too", "[cvar]") {
+  rex::cvar::testing::ResetAllForTesting();
+  int32_t value = 5;
+  auto registrar_entry = [&value](const char* name) {
+    return rex::cvar::FlagEntry{
+        .name = name,
+        .type = rex::cvar::FlagType::Int32,
+        .category = "Test",
+        .description = "Late registered int flag",
+        .setter =
+            [&value](std::string_view v) {
+              int32_t parsed = 0;
+              auto [ptr, ec] = std::from_chars(v.data(), v.data() + v.size(), parsed);
+              if (ec != std::errc() || ptr != v.data() + v.size()) {
+                return false;
+              }
+              value = parsed;
+              return true;
+            },
+        .getter = [&value]() { return std::to_string(value); },
+        .default_value = "5",
+    };
+  };
+
+  SECTION("valid value applies") {
+    InitWith({"--test_late_int=7"});
+    { rex::cvar::FlagRegistrar registrar(registrar_entry("test_late_int")); }
+    CHECK(value == 7);
+    CHECK(rex::cvar::TakeCommandLineWarnings().empty());
+  }
+
+  SECTION("invalid value is reported") {
+    InitWith({"--test_late_int=abc"});
+    { rex::cvar::FlagRegistrar registrar(registrar_entry("test_late_int")); }
+    CHECK(value == 5);
+    CHECK(rex::cvar::TakeCommandLineWarnings().size() == 1);
+  }
+
+  SECTION("bare flag that needs a value is reported") {
+    InitWith({"--test_late_int"});
+    { rex::cvar::FlagRegistrar registrar(registrar_entry("test_late_int")); }
+    CHECK(value == 5);
+    auto warnings = rex::cvar::TakeCommandLineWarnings();
+    REQUIRE(warnings.size() == 1);
+    CHECK(warnings[0].find("needs a value") != std::string::npos);
+  }
+
+  rex::cvar::testing::ResetAllForTesting();
+}
