+// Sleeps until `deadline` with sub-100us precision: a coarse OS sleep that
+// stops short of the deadline, then yields for the remainder. A plain
+// sleep_until overshoots by the timer slack (50us+ on Linux, ~1ms on
+// Windows without high-resolution timers), which shows up as pacing jitter.
+void PreciseSleepUntil(std::chrono::steady_clock::time_point deadline) {
+  using namespace std::chrono;
+#if REX_PLATFORM_WIN32
+  constexpr auto kSpinWindow = microseconds(1500);
+#else
+  constexpr auto kSpinWindow = microseconds(300);
+#endif
+  auto now = steady_clock::now();
+  if (deadline - now > kSpinWindow) {
+    std::this_thread::sleep_until(deadline - kSpinWindow);
+  }
+  while (steady_clock::now() < deadline) {
+    std::this_thread::yield();
+  }
+}
